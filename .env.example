# Copy this to .env for local testing (never commit .env to GitHub)
# Add each of these as environment variables in Railway dashboard

# --- REQUIRED ---

# From Telegram BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# From Anthropic console (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Your Telegram chat ID (you'll get this after first /start — check Railway logs)
KRISZ_CHAT_ID=your_numeric_chat_id_here

# --- GOOGLE CALENDAR ---
# After running auth_google.py, paste the full contents of token.json here as one line
GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":["..."]}

# --- OPTIONAL ---

# Path to SQLite database (Railway will use default)
# DB_PATH=trainer_bot.db

# Path to Google token file (only needed if not using GOOGLE_TOKEN_JSON)
# GOOGLE_TOKEN_PATH=token.pickle
